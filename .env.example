# Runtime configuration — validated at startup by parseEnv (packages/contracts/src/env.ts).
# Copy to .env.local for the dev server; never commit real values.

APP_ENV=development
APP_ORIGIN=http://localhost:3000
LOG_LEVEL=info

# Required in production. AUTH_SECRET must be at least 32 characters.
# AUTH_SECRET=
# DATABASE_URL=postgresql://indexly:indexly@localhost:5432/indexly
# CRAWLER_USER_AGENT=IndexlyBot/0.1 (+https://indexly.example.com/bot)
